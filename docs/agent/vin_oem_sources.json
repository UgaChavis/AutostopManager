    {
      "name": "NHTSA vPIC API",
      "kind": "api",
      "authority": "official",
      "inputs": ["vin"],
      "brands": ["many"],
      "markets": ["US", "regulated VIN markets"],
      "accepts": ["vin", "partial_vin", "model_year"],
      "outputs": ["vehicle_identity", "make", "model", "model_year", "engine_hint", "plant"],
      "access_mode": "public_api",
      "trust_level": "official_decode",
      "requires_login": false,
      "adapter_status": ["connected"],
      "url": "https://vpic.nhtsa.dot.gov/api/Home/Index",
      "notes": "Primary VIN decode source for regulated vehicles. It does not return OEM part numbers."
    },
    {
      "name": "NHTSA vPIC Home",
