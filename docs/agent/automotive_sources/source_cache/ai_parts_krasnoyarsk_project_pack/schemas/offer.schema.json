{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offer",
  "type": "object",
  "required": [
    "offer_id",
    "source_id",
    "brand",
    "article",
    "price_rub"
  ],
  "properties": {
    "offer_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "b2b_api",
        "aggregator",
        "marketplace_manual",
        "local_seller",
        "internal",
        "logistics"
      ]
    },
    "seller_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "seller_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "seller_city": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand": {
      "type": "string"
    },
    "article": {
      "type": "string"
    },
    "article_norm": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used",
        "contract",
        "rebuilt",
        "unknown"
      ]
    },
    "price_rub": {
      "type": "number",
      "minimum": 0
    },
    "delivery_cost_rub": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "quantity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "delivery_days_min": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "delivery_days_max": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warehouse_city": {
      "type": [
        "string",
        "null"
      ]
    },
    "returnable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "warranty_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fitment_basis": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "vin_oem",
        "exact_oem",
        "catalog_cross",
        "supplier_cross",
        "title_match",
        "seller_claim",
        "unknown",
        null
      ]
    },
    "stock_confirmed": {
      "type": "boolean",
      "default": false
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "scores": {
      "type": "object"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
