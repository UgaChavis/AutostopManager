[Unit]
Description=Deliver completed CRM backup to the owner's Windows PC
After=network-online.target
ConditionPathIsDirectory=/var/lib/autostop-manager/crm-backup

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/libexec/autostop-crm-backup/deliver-crm-backup.py
TimeoutStartSec=24h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/autostop-manager/crm-backup /var/lib/autostop-manager/roles/M2
