[Unit]
Description=Create an AutoStop CRM workstation backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/autostop-crm-backup/crm_backup_coordinator.py backup
ExecStopPost=/usr/bin/systemctl start --no-block autostop-crm-workstation-recovery.service
KillMode=control-group
TimeoutStartSec=30min
TimeoutStopSec=2min
